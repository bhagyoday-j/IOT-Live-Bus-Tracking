# ╔══════════════════════════════════════════════════════════════════╗
# ║              SmartTransit AI - Environment Variables             ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Application ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# ── MongoDB (Atlas recommended for production) ─────────────────────
MONGODB_URI=mongodb://localhost:27017/smarttransit
# MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@cluster.mongodb.net/smarttransit?retryWrites=true&w=majority

# ── JWT Authentication ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── MQTT (EMQX Broker) ─────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=smarttransit
MQTT_PASSWORD=smarttransit_secret
MQTT_CLIENT_ID=smarttransit-backend
MQTT_TOPIC_PREFIX=bus

# ── Redis (Cache + Socket.IO Adapter) ──────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ── Firebase Cloud Messaging (Push Notifications) ──────────────────
FCM_PROJECT_ID=smarttransit-xxxxx
FCM_PRIVATE_KEY_PATH=./config/firebase-service-account.json
# Alternative: use JSON string directly
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── OSRM (Route Optimization API) ───────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=5000

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100    # Max 100 requests per window

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Device Authentication ───────────────────────────────────────────
DEVICE_SECRET_SALT=your-device-salt-change-in-production
